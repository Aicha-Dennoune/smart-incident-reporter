rules_version = '2';
// À déployer dans Firebase Console → Storage → Règles.
// Dossier fichiers : incidents/{userId}/{incidentId}/...

service firebase.storage {
  match /b/{bucket}/o {
    match /incidents/{userId}/{incidentId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
